# Root level .gitignore for Monorepo

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# PHP / Laravel (backend-php)
backend-php/vendor/
backend-php/.env
backend-php/.env.*
backend-php/storage/*.key
backend-php/storage/logs/*
backend-php/storage/framework/cache/*
backend-php/storage/framework/sessions/*
backend-php/storage/framework/views/*
backend-php/bootstrap/cache/*
!backend-php/storage/.gitkeep
!backend-php/storage/logs/.gitkeep
!backend-php/storage/framework/.gitkeep
!backend-php/storage/framework/cache/.gitkeep
!backend-php/storage/framework/sessions/.gitkeep
!backend-php/storage/framework/views/.gitkeep
backend-php/.phpunit.result.cache
backend-php/.php_cs.cache
backend-php/composer.phar
composer.phar
/vendor/

# .NET (microservice-net)
microservice-net/bin/
microservice-net/obj/
microservice-net/**/bin/
microservice-net/**/obj/
microservice-net/*.user
microservice-net/*.suo
microservice-net/*.userosscache
microservice-net/*.sln.docstates
microservice-net/appsettings.Development.json
microservice-net/appsettings.*.json
!microservice-net/appsettings.json
microservice-net/.vs/
microservice-net/.vscode/
microservice-net/*.db
microservice-net/*.db-shm
microservice-net/*.db-wal
microservice-net/packages/
microservice-net/.vs/
microservice-net/.idea/
microservice-net/*.swp
microservice-net/*.swo
microservice-net/*.userprefs
microservice-net/.DS_Store

# React Native (mobile-app)
mobile-app/node_modules/
mobile-app/android/app/build/
mobile-app/android/build/
mobile-app/android/.gradle/
mobile-app/android/local.properties
mobile-app/android/app/release/
mobile-app/android/keystore.properties
mobile-app/ios/Pods/
mobile-app/ios/build/
mobile-app/ios/*.xcworkspace/xcuserdata/
mobile-app/ios/*.xcodeproj/xcuserdata/
mobile-app/ios/*.xcworkspace/xcshareddata/
mobile-app/.expo/
mobile-app/.expo-shared/
mobile-app/dist/
mobile-app/.npm/
mobile-app/.yarn/
mobile-app/.pnp.*
mobile-app/.yarn-integrity
mobile-app/.env
mobile-app/.env.local
mobile-app/.env.*.local
mobile-app/coverage/
mobile-app/.nyc_output/
mobile-app/*.log
mobile-app/.metro-health-check*

# Infrastructure
infrastructure/.env
infrastructure/.env.*
infrastructure/*.log

# Node / JS
node_modules/
**/node_modules/

# Local build outputs
.build/

# General
*.log
*.tmp
*.temp
.cache/
temp/
tmp/
.env.local
.env.*.local
