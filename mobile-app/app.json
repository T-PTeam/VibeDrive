{
  "expo": {
    "name": "VibeDrive",
    "slug": "vibedrive-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibedrive.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VD needs access to your microphone to record voice commands while driving.",
        "NSBluetoothAlwaysUsageDescription": "VD needs Bluetooth access to connect to LED controllers and other BLE devices.",
        "NSBluetoothPeripheralUsageDescription": "VD needs Bluetooth access to connect to LED controllers and other BLE devices.",
        "LSApplicationQueriesSchemes": [
          "spotify",
          "spotify"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "android": {
        "adaptiveIcon": {
          "foregroundImage": "./assets/android/play_store_512.png",
          "backgroundColor": "#000000"
        },
        "package": "com.vibedrive.mobile",
        "permissions": [
          "RECORD_AUDIO",
          "BLUETOOTH",
          "BLUETOOTH_ADMIN",
          "BLUETOOTH_SCAN",
          "BLUETOOTH_CONNECT",
          "ACCESS_FINE_LOCATION"
        ]
      },
      "web": {},
      "scheme": "vibedrive",
      "privacyPolicyUrl": "https://vibe-drive.store/privacy",
      "extra": {
        "eas": {
          "projectId": "88fd6011-4763-47e6-a643-e11ae39ccf10"
        },
        "termsOfUseUrl": "https://vibe-drive.store/terms"
      },
      "plugins": [
        "expo-secure-store",
        "expo-iap"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "88fd6011-4763-47e6-a643-e11ae39ccf10"
      }
    }
  }
}
