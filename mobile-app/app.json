{
  "expo": {
    "name": "VibeDrive",
    "slug": "vibedrive-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibedrive.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VibeDrive needs access to your microphone to record voice commands while driving.",
        "LSApplicationQueriesSchemes": ["spotify", "spotify"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.vibedrive.mobile",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {},
    "scheme": "vibedrive",
    "extra": {
      "eas": {
        "projectId": "88fd6011-4763-47e6-a643-e11ae39ccf10"
      }
    },
    "plugins": ["expo-secure-store", "expo-web-browser"]
  }
}
