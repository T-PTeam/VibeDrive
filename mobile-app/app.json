{
  "expo": {
    "name": "VibeDrive",
    "slug": "vibedrive-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibedrive.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VibeDrive needs access to your microphone to record voice commands while driving."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.vibedrive.mobile",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {}
  }
}
