{
  "expo": {
    "name": "VibeDrive",
    "slug": "vibedrive-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "scheme": "vibedrive",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibedrive.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VD needs access to your microphone to record voice commands while driving.",
        "NSBluetoothAlwaysUsageDescription": "VD needs Bluetooth access to connect to LED controllers and other BLE devices.",
        "NSBluetoothPeripheralUsageDescription": "VD needs Bluetooth access to connect to LED controllers and other BLE devices.",
        "LSApplicationQueriesSchemes": ["spotify", "spotify"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/play_store_512.png",
        "backgroundColor": "#000000"
      },
      "package": "com.vibedrive.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ],
      "privacyPolicyUrl": "https://vibe-drive.store/privacy"
    },
    "extra": {
      "eas": {
        "projectId": "16bab08b-19e5-4898-aaf2-bf49c0ab370c"
      },
      "termsOfUseUrl": "https://vibe-drive.store/terms"
    },
    "plugins": [
      "expo-secure-store",
      "expo-iap",
      [
        "react-native-vosk",
        {
          "models": ["./assets/model-wake-en"],
          "iOSMicrophonePermission": "VD needs access to your microphone to record voice commands while driving."
        }
      ]
    ],
    "owner": "theleftoverlck"
  }
}
