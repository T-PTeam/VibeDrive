# Production environment for Expo/EAS builds.
# Copy to .env for local overrides or set these as EAS Secrets for CI builds.
# Both API URLs point to the same Nginx-terminated HTTPS host — no direct ports.

EXPO_PUBLIC_API_URL=https://vibe-drive.store
EXPO_PUBLIC_PHP_API_URL=https://vibe-drive.store/api
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=REPLACE_WITH_SPOTIFY_CLIENT_ID
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=vibedrive://spotify-callback
